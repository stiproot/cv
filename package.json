{
  "name": "simon-stipcich-cv",
  "version": "1.0.0",
  "description": "Simon Stipcich - Software Developer CV",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "lint": "bunx oxlint . && bunx oxfmt --check . && bun scripts/check-tokens.ts",
    "format": "bunx oxfmt .",
    "generate:pdf": "bun scripts/generate-pdf.mjs",
    "build:with-pdf": "bun run build && bun run generate:pdf",
    "clean": "rm -rf dist *.tsbuildinfo .astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.58.2",
    "typescript": "~5.9.2"
  }
}
