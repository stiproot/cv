---
import type { ArticleEntry } from "../data/cv";

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;

const isVideo = article.type === "video";
const icon = isVideo
  ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>'
  : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>';
---

<a href={article.href} class="article-card">
  <div class="article-tile" style={`background-color: var(--color-kind-article-tint);`}>
    <div class="article-icon">
      <Fragment set:html={icon} />
    </div>
  </div>
  <div class="article-content">
    <div class="article-eyebrow">
      {isVideo ? "VIDEO" : "ARTICLE"} · {article.source}
    </div>
    <h4 class="article-title">{article.title}</h4>
    <p class="article-summary">{article.summary}</p>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-card);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .article-tile {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-kind-article);
  }

  .article-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .article-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    color: var(--color-kind-article);
  }

  .article-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: var(--space-2) 0;
  }

  .article-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
