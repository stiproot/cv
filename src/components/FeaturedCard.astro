---
import type { Subsection } from "../data/cv";
import LinkChip from "./LinkChip.astro";

interface Props {
  project: Subsection;
}

const { project } = Astro.props;
---

<div class="featured-card card">
  <div class="featured-content">
    <div class="featured-eyebrow">FEATURED · LIVE APP</div>
    <h2 class="featured-title">{project.title}</h2>
    <p class="featured-description">{project.description}</p>
    {project.stack && (
      <div class="featured-stack">
        {project.stack.join(", ")}
      </div>
    )}
  </div>
  {project.links && project.links.length > 0 && (
    <div class="featured-links">
      {project.links.map((link) => (
        <LinkChip kind={link.kind} label={link.label} href={link.href} inverted />
      ))}
    </div>
  )}
</div>

<style>
  .featured-card {
    background-color: var(--color-kind-site);
    color: white;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .featured-content {
    flex: 1;
  }

  .featured-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    opacity: 0.9;
    margin-bottom: var(--space-2);
  }

  .featured-title {
    font-size: var(--text-featured);
    font-weight: var(--font-weight-extrabold);
    margin: 0 0 var(--space-3) 0;
  }

  .featured-description {
    font-size: var(--text-lg);
    opacity: 0.95;
    margin: 0 0 var(--space-3) 0;
  }

  .featured-stack {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .featured-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media print {
    .featured-card {
      background-color: transparent;
      color: black;
    }

    .featured-eyebrow {
      color: black;
      opacity: 1;
    }

    .featured-title {
      color: black;
    }

    .featured-description {
      color: black;
      opacity: 1;
    }

    .featured-stack {
      color: black;
      opacity: 1;
    }
  }
</style>
